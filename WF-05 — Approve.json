        "operation": "executeQuery",
        "query": "SELECT m.id, m.subject, m.body, c.name AS contact_name, c.email\nFROM messages m\nJOIN contacts c ON c.id = m.contact_id\nWHERE m.status = 'draft' AND m.approved = false\nORDER BY m.id;",
        "options": {}
      },
