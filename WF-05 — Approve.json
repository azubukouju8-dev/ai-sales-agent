    {
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nlet html = `<html><head><style>\nbody{font-family:sans-serif;max-width:800px;margin:20px auto;padding:0 15px}\n.card{border:1px solid #ddd;border-radius:8px;padding:16px;margin:16px 0}\n.sub{font-weight:bold;font-size:18px}\n.to{color:#666;margin:4px 0}\n.body{white-space:pre-wrap;margin:12px 0;color:#333}\na{display:inline-block;padding:8px 16px;border-radius:6px;text-decoration:none;margin-right:8px}\n.ok{background:#16a34a;color:#fff}.no{background:#dc2626;color:#fff}\n</style></head><body><h2>Draft Emails (${rows.length})</h2>`;\nfor (const r of rows) {\n  html += `<div class=\"card\">\n    <div class=\"sub\">${r.subject}</div>\n    <div class=\"to\">To: ${r.contact_name} &lt;${r.email}&gt;</div>\n    <div class=\"body\">${r.body}</div>\n    <a class=\"ok\" href=\"/webhook/decide?id=${r.id}&d=ok\">Approve</a>\n    <a class=\"no\" href=\"/webhook/decide?id=${r.id}&d=no\">Reject</a>\n  </div>`;\n}\nhtml += `</body></html>`;\nreturn [{ json: { html } }];"
      },
