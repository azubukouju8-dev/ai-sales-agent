      "parameters": {
        "jsCode": "const valid = ['interested','question','not_interested','unsubscribe','out_of_office'];\nreturn items.map((item, i) => {\n  let out = { category: 'not_interested', route: 'auto' };\n  try {\n    const text = item.json.text || '';\n    const m = text.match(/\\{[\\s\\S]*\\}/);\n    if (m) out = JSON.parse(m[0]);\n  } catch (e) {}\n  if (!valid.includes(out.category)) out.category = 'not_interested';\n  const route = (out.category === 'interested' || out.category === 'question') ? 'human' : 'auto';\n  const src = $('Execute a SQL query').all()[i].json;\n  return {\n    json: {\n      reply_id: src.id,\n      from_email: src.from_email,\n      category: out.category,\n      route: route\n    }\n  };\n});"
      },
