      "parameters": {
        "jsCode": "return items.map((item, i) => {\n  let out = { fit: false, score: 0, reason: 'parse error' };\n  try {\n    const text = item.json.text || '';\n    const match = text.match(/\\{[\\s\\S]*\\}/);\n    if (match) out = JSON.parse(match[0]);\n  } catch (e) {}\n\n  // get the matching project id from the SQL node, by position\n  const proj = $('Execute a SQL query').all()[i].json;\n\n  return {\n    json: {\n      id: proj.id,\n      status: out.fit ? 'qualified' : 'rejected',\n      score: out.score ?? 0,\n      reason: (out.reason || '').slice(0, 300)\n    }\n  };\n});"
