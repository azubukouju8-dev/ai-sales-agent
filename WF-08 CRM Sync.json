  "name": "WF-08 CRM Sync",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id AS contact_id, c.project_id, c.name, c.email,\n       co.name AS company, p.title AS project\nFROM contacts c\nJOIN companies co ON co.id = c.company_id\nJOIN projects p ON p.id = c.project_id\nWHERE c.synced = false\nORDER BY c.id\nLIMIT 20;",
        "options": {}
      },
