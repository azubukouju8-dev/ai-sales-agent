    {
      "parameters": {
        "jsCode": "return items.map((item, i) => {\n  let out = { subject: '', body: '' };\n  try {\n    const text = item.json.text || '';\n    const match = text.match(/\\{[\\s\\S]*\\}/);\n    if (match) out = JSON.parse(match[0]);\n  } catch (e) {}\n  const src = $('Execute a SQL query').all()[i].json;\n  return {\n    json: {\n      project_id: src.project_id,\n      contact_id: src.contact_id,\n      subject: (out.subject || '').slice(0, 300),\n      body: (out.body || '').slice(0, 3000)\n    }\n  };\n});"
      },
